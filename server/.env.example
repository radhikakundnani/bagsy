# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/bagsy?retryWrites=true&w=majority

# Long random string for signing logins: run  openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Website address(es) allowed to call the API, comma-separated. Also used in password-reset emails.
CLIENT_URL=http://localhost:3000

# https://home.openweathermap.org/api_keys
WEATHER_API_KEY=your_openweathermap_key_here

# https://aistudio.google.com -> Get API key (optional: without it, Bagsy works with no AI suggestions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail address + app password for password-reset emails (optional)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ML item sorter (on by default). Set to off to save memory on small servers.
ITEM_SORTER=on
